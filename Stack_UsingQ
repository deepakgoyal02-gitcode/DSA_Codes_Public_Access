 class StackUsingQueue {

        Queue<Integer> q = new ArrayDeque<>();

        void push(int x) {
            q.offer(x);
            for (int i = 0; i < q.size() - 1; i++)
                q.offer(q.poll());
        }

        int pop() {
            return q.poll();
        }

        int top() {
            return q.peek();
        }
    }

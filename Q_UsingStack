class QueueUsingStacks {

        Deque<Integer> in = new ArrayDeque<>(), out = new ArrayDeque<>();

        void enqueue(int x) {
            in.push(x);
        }

        int dequeue() {
            if (out.isEmpty())
                while (!in.isEmpty())
                    out.push(in.pop());
            return out.pop();
        }
    }

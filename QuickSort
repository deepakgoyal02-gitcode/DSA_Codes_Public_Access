public static int quickPartition(int[] arr, int left, int right, int pIndex)
    {
        while(true)
        {
            //scan from right to left
                while ((arr[pIndex] <= arr[right]) && (pIndex != right))
                    right--;

                if (pIndex == right)
                    return pIndex;

                if (arr[pIndex] > arr[right])
                {
                    swap(arr, pIndex, right);
                    pIndex = right;
                }

            //scan from left to right
                while ((arr[pIndex] >= arr[left]) && (pIndex != left))
                    left++;

                if(pIndex==left)
                    return pIndex;

                if(arr[pIndex] < arr[left])
                {
                    swap(arr,pIndex,left);
                    pIndex = left;
                }

        }
    }
    static void swap(int[] arr, int i, int j) {
        int temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;
    }
    public static void quickSort(int[] arr,int low,int high)
    {
        if (low < high)
        {
            int partitionIndex = quickPartition(arr, low, high, high);

            quickSort(arr, low, partitionIndex - 1);
            quickSort(arr, partitionIndex + 1, high);
        }
    }

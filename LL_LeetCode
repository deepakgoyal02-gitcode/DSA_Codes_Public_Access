    public static SinglyLinkedList createSortedList(int[] arr) 
    {
        SinglyLinkedList lList = new SinglyLinkedList();

        for(int value:arr)
            lList.insertSorted(value);
        lList.display();
        return lList;
    }

    public static int getLength(Node head) {
        int length = 0;
        Node current = head;
        while (current != null) {
            length++;             
            current = current.next; 
        }
        return length;
    }

    public static boolean search(Node head, int target) {
        Node current = head;

        while (current != null)
        {
            if (current.data == target)
                return true;
            current = current.next;
        }

        return false;
    }

    public static Node deleteDuplicates(Node head) {

        Node current = head;

        while (current != null && current.next != null)
        {
            if (current.data == current.next.data)
                current.next = current.next.next; 
             else
                current = current.next; 
        }
        return head;
    }

    public static Node findMiddleNode(Node head) {
        Node slow = head;
        Node fast = head;
        while (fast != null && fast.next != null)
        {
            slow = slow.next;       // Moves 1 step
            fast = fast.next.next;  // Moves 2 steps
        }
        return slow;
    }

    public static Node reverseList(Node head)
    {
        Node prev = null;
        Node current = head;
        while (current != null)
        {
            Node nextTemp = current.next;     
            current.next = prev;              
            prev = current;                   
            current = nextTemp;               
        }
        return prev;
    }

    public static Node getNthFromEnd(Node head, int n) {
               Node first = head;
        Node second = head;
        for (int i = 0; i < n; i++) {
            if (first == null)
                return null;
            first = first.next;
        }
        while (first != null) {
            first = first.next;
            second = second.next;
        }
        return second;
    }

    public static boolean hasCycle(Node head) {
        if (head == null || head.next == null)
            return false; 
        Node slow = head;
        Node fast = head; 
        while (fast != null && fast.next != null) {
            slow = slow.next;       
            fast = fast.next.next;  
            if (slow == fast)
                return true;
        }
        return false;
    }
   public static Node merge(Node list1, Node list2)
    {
        Node l3Head = new Node(0), l3curr = l3Head;

        while (list1 != null && list2 != null)
        {
            if (list1.data <= list2.data)
            {
                l3curr.next = list1;
                list1 = list1.next;
            }
            else
            {
                l3curr.next = list2;
                list2 = list2.next;
            }
            l3curr = l3curr.next;
        }

        if(list1!=null)
            l3curr.next = list1;
        else
            l3curr.next = list2;

        return l3Head.next;
    }

}
